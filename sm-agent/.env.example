# Environment variables for local development
# Copy this file to .env and update with your values

# Azure AI Foundry
FOUNDRY_ENDPOINT=
FOUNDRY_SUBSCRIPTION_ID=
FOUNDRY_RESOURCE_GROUP=
FOUNDRY_PROJECT_NAME=

# Microsoft Fabric
FABRIC_TENANT_ID=
FABRIC_DEFAULT_WORKSPACE_ID=

# Authentication
USE_MANAGED_IDENTITY=false  # Set to true in Azure environments

# Deployment
REQUIRE_APPROVAL_FOR_PRODUCTION=true
DRY_RUN_ENABLED=true

# Logging
LOG_LEVEL=INFO

# Azure Key Vault (optional for local dev)
# AZURE_KEY_VAULT_NAME=
